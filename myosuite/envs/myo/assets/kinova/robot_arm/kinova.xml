<mujoco model="my_custom_scene">
  <!-- Scene-wide settings -->
  <compiler angle="radian"/>
  <option integrator="implicitfast"/>

  <!-- Load assets and defaults -->
  <include file="../../../../../simhive/robot_arm_sim/scene/myosuite_scene_kinova.xml"/>
  <include file="arm_assets.xml"/>
  <include file="../../../../../simhive/robot_arm_sim/arm/myoarm_assets_kinova.xml"/>
  <include file="gen3_assets.xml"/>
  <include file="robotiq_assets.xml"/>
  

  <asset>

  </asset>

  <!-- World body -->
  <worldbody>
    <body name="robot" pos="0 0 0">
      <!-- wheelchair just a cube cause i can't find any wheelchair models lmao -->
      <geom name="wheelchair" type="box" size="0.3 0.3 0.3" pos="0 0 0.25" rgba="0 0 0 1"/>
      <!-- Kinova Gen3 arm -->
      <body name="robot_arm_gripper" pos="0 0 0.5">
        <body name="gen3_base" pos="0 0 0">
          <include file="gen3_body.xml"/>
        </body>
      </body>

    </body>

    <!-- MyoArm -->
    <body name="myoarm" pos="1.2 0 0" axisangle="0 0 1 -1.5708">
      <include file="arm_body.xml"/>
    </body>

    <body name="table" pos="0.7 0 0" axisangle="0 0 1 1.5708">
      <include file="simpleWoodTable_body.xml"/>
    </body>

    
  </worldbody>

  <!-- Actuators -->
  <include file="gen3_actuator.xml"/>
  <include file="robotiq_actuators.xml"/>

  <!-- Sensors, keyframes, etc -->
  <include file="robotiq_sensors.xml"/>
  <!-- <include file="gen3_keyframes.xml"/> -->
  <!-- <include file="arm_keyframes.xml"/> -->
</mujoco>

